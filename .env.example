# Server-only Cloudflare R2 credentials. Set these as Worker secrets in production.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Needed by server functions to validate the Supabase access token with RLS.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
